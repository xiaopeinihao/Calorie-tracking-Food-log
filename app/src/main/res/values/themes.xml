<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme; the actual look is driven by Compose Material3 in Theme.kt.
         We only need a light-status-bar, no ActionBar shell here. -->
    <style name="Theme.CalorieTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
